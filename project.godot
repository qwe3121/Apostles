; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TheGame"
run/main_scene="res://src/menus/main_menu_oog.tscn"
config/features=PackedStringArray("4.0", "Forward Plus")
config/icon="res://icon.svg"
run/layer_12="hitbox"

[autoload]

snl="*res://src/autoloads/snl.gd"
events="*res://src/autoloads/events.gd"
cfg="*res://src/autoloads/cfg.gd"
MusicTestAutoload="*res://src/autoloads/music_test_autoload.tscn"
global_settings="*res://src/autoloads/global_settings.gd"
trans="*res://src/autoloads/transition.tscn"
nt="*res://src/autoloads/notification.tscn"
global="*res://src/autoloads/global.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

export/convert_text_resources_to_binary=true

[gui]

theme/custom_font="res://fonts/molot_font.tres"

