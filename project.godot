; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Apostles"
run/main_scene="res://src/world.tscn"
config/features=PackedStringArray("4.1", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/size/transparent=false

[autoload]

snl="*res://src/autoloads/snl.gd"
events="*res://src/autoloads/events.gd"
cfg="*res://src/autoloads/cfg.gd"
global_settings="*res://src/autoloads/global_settings.gd"
trans="*res://src/autoloads/transition.tscn"
nt="*res://src/autoloads/notification.tscn"
global="*res://src/autoloads/global.gd"
blood_manager="*res://src/autoloads/blood_manager.gd"
Dialogic="*res://addons/dialogic/Other/DialogicGameHandler.gd"
dialog="*res://src/autoloads/dialog.gd"
AudioAutoload="*res://src/autoloads/audio_autoload.tscn"
particles_manager="*res://src/autoloads/particles_manager.tscn"

[dialogic]

editor/character_preview_mode=0
editor/current_editor=&"Timeline Editor"
editor/current_resources={
"Character Editor": "res://src/dialogues/chars/test.dch",
"Timeline Editor": "res://src/dialogues/timelines/test.dtl"
}
editor/last_resources=PackedStringArray("res://src/dialogues/timelines/test.dtl", "res://src/dialogues/chars/test.dch")
editor/last/resources=["res://src/dialogues/timelines/test.dtl", "res://src/dialogues/chars/test.dch"]
editor/visual_timeline_editor_sidebar=200.0
editor/current_timeline_path="res://src/dialogues/timelines/test.dtl"
variables={}
layout/mode=0
glossary/default_case_sensitive=true
animations/join_default_length=0.5
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/join_default_wait=true
choices/autofocus_first=true
choices/delay=0.2
save/autosave_delay=60.0
text/speed=0.01
text/skippable=true
text/autocontinue_delay=1.0
text/autopauses={}
editor/timeline_editor_mode=0
portrait_mode=0
text/autocolor_names=false
layout/end_behaviour=0

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[filesystem]

import/blender/enabled=false

[gui]

theme/custom_font="res://fonts/molot_font.tres"

